// PostgreSQL Schema for CampusMart
// Prisma schema file for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  CAMPUS_HERO
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model College {
  id                       String                  @id @default(uuid())
  code                     String                  @unique
  name                     String
  is_active                Boolean                 @default(true)
  created_at               DateTime                @default(now())
  users                    User[]
  sell_requests            SellRequest[]
  buy_requests             BuyRequest[]
  campus_hero_applications CampusHeroApplication[]
  delivery_tasks           DeliveryTask[]
  custom_item_submissions  CustomItemSubmission[]
  team_posts               TeamPost[]

  @@map("colleges")
}

model User {
  id                       String                  @id @default(uuid())
  name                     String
  email                    String                  @unique
  phone                    String
  password_hash            String
  college_id               String
  college                  College                 @relation(fields: [college_id], references: [id])
  role                     Role                    @default(USER)
  marketplace_mode         String                  @default("BUYER")
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  sell_requests            SellRequest[]
  buy_requests             BuyRequest[]
  campus_hero_applications CampusHeroApplication[]
  hero_tasks               DeliveryTask[]          @relation("HeroTasks")
  sent_messages            Message[]               @relation("SentMessages")
  received_messages        Message[]               @relation("ReceivedMessages")
  custom_item_submissions  CustomItemSubmission[]
  hackathon_profile        HackathonProfile?
  created_teams            TeamPost[]              @relation("CreatedTeams")
  team_applications        TeamApplication[]       @relation("ApplicantApplications")

  @@map("users")
}

model Product {
  id                      String         @id @default(uuid())
  name                    String
  description             String
  image_url               String
  images                  String         @default("[]") // JSON array of multiple showcase images
  category                String
  buy_price               Float          // Base/fixed buying price
  upto_buy_price          Float?         // "Up to" maximum price students can receive
  sell_price              Float          // Admin-determined selling price (what buyer pays)
  is_buying_enabled       Boolean        @default(true) // We are currently buying this item
  is_active               Boolean        @default(true) // Visible in catalog
  quality_questions       String         @default("[]") // JSON array of quality check questions
  
  // Auto-Match & Auto-Accept Rules
  auto_match_enabled      Boolean        @default(true)
  max_campus_inventory    Int            @default(10)
  auto_accept_conditions  String         @default("[\"Like New\", \"Good\"]")
  require_photos_for_auto Boolean        @default(true)
  min_payout_for_auto     Float?
  
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  sell_requests           SellRequest[]
  buy_requests            BuyRequest[]
  delivery_tasks          DeliveryTask[]
  custom_item_submissions CustomItemSubmission[]

  @@map("products")
}

model SellRequest {
  id               String         @id @default(uuid())
  user_id          String
  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_id       String
  product          Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  college_id       String
  college          College        @relation(fields: [college_id], references: [id], onDelete: Cascade)
  condition        String         // "Like New", "Good", "Used"
  description      String?
  images           String         @default("[]") // JSON string of student uploaded image URLs
  quality_answers  String         @default("{}") // JSON string of student quality check responses
  estimated_price  Float?         // Dynamic calculated price based on quality check
  admin_buy_price  Float?         // Price paid to student
  admin_sell_price Float?         // Price set for buyer
  status           RequestStatus  @default(PENDING)
  auto_matched     Boolean        @default(false)
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  delivery_tasks          DeliveryTask[]
  messages                Message[]
  custom_item_submissions CustomItemSubmission[]

  @@map("sell_requests")
}

model BuyRequest {
  id                      String         @id @default(uuid())
  user_id                 String
  user                    User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product_id              String
  product                 Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  college_id              String
  college                 College        @relation(fields: [college_id], references: [id], onDelete: Cascade)
  status                  RequestStatus  @default(PENDING)
  notes                   String?
  auto_matched            Boolean        @default(false)
  matched_sell_request_id String?
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  delivery_tasks          DeliveryTask[]
  messages                Message[]

  @@map("buy_requests")
}

model CampusHeroApplication {
  id         String        @id @default(uuid())
  user_id    String
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  college_id String
  college    College       @relation(fields: [college_id], references: [id], onDelete: Cascade)
  branch     String
  year       String
  phone      String
  instagram  String?
  linkedin   String?
  reason     String
  status     RequestStatus @default(PENDING)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@map("campus_hero_applications")
}

model DeliveryTask {
  id               String       @id @default(uuid())
  task_type        String       // "PICKUP", "DROP", "MATCHED_EXCHANGE"
  sell_request_id  String?
  sell_request     SellRequest? @relation(fields: [sell_request_id], references: [id], onDelete: SetNull)
  buy_request_id   String?
  buy_request      BuyRequest?  @relation(fields: [buy_request_id], references: [id], onDelete: SetNull)
  product_id       String
  product          Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  college_id       String
  college          College      @relation(fields: [college_id], references: [id], onDelete: Cascade)
  assigned_hero_id String?
  assigned_hero    User?        @relation("HeroTasks", fields: [assigned_hero_id], references: [id], onDelete: SetNull)
  status           String       @default("ASSIGNED")
  quality_verified Boolean      @default(false)
  pickup_notes     String?
  delivery_notes   String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  messages         Message[]

  @@map("delivery_tasks")
}

model Message {
  id                  String        @id @default(uuid())
  sender_id           String
  sender              User          @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  sender_display_name String        @default("Operations Team — Campus Hero")
  receiver_id         String
  receiver            User          @relation("ReceivedMessages", fields: [receiver_id], references: [id], onDelete: Cascade)
  task_id             String?
  task                DeliveryTask? @relation(fields: [task_id], references: [id], onDelete: SetNull)
  sell_request_id     String?
  sell_request        SellRequest?  @relation(fields: [sell_request_id], references: [id], onDelete: SetNull)
  buy_request_id      String?
  buy_request         BuyRequest?   @relation(fields: [buy_request_id], references: [id], onDelete: SetNull)
  content             String
  is_read             Boolean       @default(false)
  created_at          DateTime      @default(now())

  @@map("messages")
}

model CustomItemSubmission {
  id                      String       @id @default(uuid())
  user_id                 String
  user                    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  college_id              String
  college                 College      @relation(fields: [college_id], references: [id], onDelete: Cascade)
  name                    String
  category                String
  condition               String
  description             String
  expected_price          Float?
  images                  String       @default("[]")
  status                  RequestStatus @default(PENDING)
  rejection_reason        String?
  admin_buy_price         Float?
  admin_sell_price        Float?
  created_product_id      String?
  product                 Product?     @relation(fields: [created_product_id], references: [id], onDelete: SetNull)
  created_sell_request_id String?
  sell_request            SellRequest? @relation(fields: [created_sell_request_id], references: [id], onDelete: SetNull)
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt

  @@map("custom_item_submissions")
}

model HackathonProfile {
  id               String   @id @default(uuid())
  user_id          String   @unique
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bio              String   @default("")
  skills           String   @default("[]") // JSON array string of skills
  preferred_roles  String   @default("[]") // JSON array string of roles
  github_url       String?
  portfolio_url    String?
  linkedin_url     String?
  experience_level String   @default("Intermediate") // Beginner, Intermediate, Advanced
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("hackathon_profiles")
}

model TeamPost {
  id                   String            @id @default(uuid())
  creator_id           String
  creator              User              @relation("CreatedTeams", fields: [creator_id], references: [id], onDelete: Cascade)
  college_id           String
  college              College           @relation(fields: [college_id], references: [id], onDelete: Cascade)
  hackathon_name       String            // e.g. "Smart India Hackathon (SIH 2026)"
  team_title           String            // e.g. "AI HealthCare Innovators"
  description          String
  skills_needed        String            @default("[]") // JSON array string
  required_roles       String            @default("[]") // JSON array string
  max_team_size        Int               @default(6)    // Configurable team capacity (e.g. SIH typically 6)
  eligibility_rules    String            @default("OPEN_TO_ALL") // "OPEN_TO_ALL" or "SAME_COLLEGE_ONLY"
  eligibility_notes    String?           // Freeform instructions, e.g. "Must have at least 1 female teammate as per SIH guidelines"
  application_deadline DateTime
  status               String            @default("OPEN") // "OPEN", "FULL", "CLOSED", "REMOVED"
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  applications         TeamApplication[]

  @@map("team_posts")
}

model TeamApplication {
  id               String   @id @default(uuid())
  team_post_id     String
  team_post        TeamPost @relation(fields: [team_post_id], references: [id], onDelete: Cascade)
  applicant_id     String
  applicant        User     @relation("ApplicantApplications", fields: [applicant_id], references: [id], onDelete: Cascade)
  role_applied     String
  message          String
  status           String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  rejection_reason String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([team_post_id, applicant_id])
  @@map("team_applications")
}

